# Flowable 引擎连接配置
# 修改后需要重启后端

# 运行模式: mock | flowable
# mock: 使用内存 Mock，不需要 Docker，适合学习和演示
# flowable: 连接真实的 Flowable 引擎
MODE=mock

# Flowable REST API 地址（MODE=flowable 时使用）
FLOWABLE_URL=http://localhost:8080

# Flowable 认证（basic auth）
FLOWABLE_USER=flowable
FLOWABLE_PASSWORD=***

# MySQL 连接信息（Flowable 模式使用，仅用于 docker compose）
DB_URL=jdbc:mysql://mysql:3306/flowable
DB_USERNAME=flowable
DB_PASSWORD=***

# 端口
PORT=3000

# CORS
ALLOWED_ORIGINS=http://localhost:5173
